# Usługa systemd: /etc/systemd/system/home-manager.service
[Unit]
Description=Manager zasobów domowych
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homemanager
Group=homemanager
WorkingDirectory=/opt/home-manager
EnvironmentFile=/etc/home-manager/home-manager.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

# Utwardzenie: aplikacja zapisuje tylko w /var/lib/home-manager
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/home-manager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
