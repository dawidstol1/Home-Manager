# Konfiguracja: /etc/home-manager/home-manager.env  (chmod 640, właściciel root:homemanager)

# Baza PostgreSQL na drugim serwerze.
# Zamień HASLO i 192.168.1.20 na swoje. sslmode=no-verify = połączenie szyfrowane (bez sprawdzania certyfikatu).
DATABASE_URL=postgres://homemanager:HASLO@192.168.1.20:5432/homemanager?sslmode=no-verify

# Aplikacja słucha tylko lokalnie – z zewnątrz wchodzi się przez nginx (HTTPS).
# Jeśli nie używasz nginx na tym LXC (np. masz osobny reverse proxy), ustaw HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Za reverse proxy: ufaj nagłówkom X-Forwarded-* (prawdziwy adres IP i HTTPS).
TRUST_PROXY=1

# Pliki: zdjęcia produktów i dokumenty sprzętów (paragony, gwarancje, instrukcje).
IMAGES_DIR=/var/lib/home-manager/images
UPLOADS_DIR=/var/lib/home-manager/uploads

# Strefa czasowa raportów wydatków.
REPORT_TZ=Europe/Warsaw

# Wyszukiwanie nazw i zdjęć produktów w Open Food Facts (off = wyłączone).
PRODUCT_LOOKUP=on

NODE_ENV=production

# --- Monitorowanie: OpenTelemetry – szczegóły: docs/MONITOROWANIE-ZABBIX.md ---
# A) Zabbix bez ClickHouse (szablon deploy/zabbix/zasoby-domowe-template.yaml): metryki pod http://ADRES:9464/metrics
#OTEL_METRICS_EXPORTER=prometheus
#OTEL_EXPORTER_PROMETHEUS_PORT=9464
# B) Zabbix 8.0 APM (proxy z APM + ClickHouse): ślady, metryki i logi przez OTLP/gRPC
#OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.40:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_SERVICE_NAME=home-manager
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dom,host.name=zasoby
